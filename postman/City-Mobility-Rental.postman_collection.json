    {
      "name": "Rental business rules",
      "description": "Run these requests in order. They verify that a renter cannot have two active rentals.",
      "item": [
        {
          "name": "Create first rental for renter",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"activeRentalRenterId\", \"postman-active-renter-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"first rental returns 201 Created\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"first rental is active\", function () { pm.expect(pm.response.json().status).to.eql(\"ACTIVE\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"renterId\": \"{{activeRentalRenterId}}\",\n  \"providerId\": \"city-bike\",\n  \"vehicleId\": \"bike-active-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/api/rentals",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "rentals"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reject second active rental for same renter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"second rental returns 409 Conflict\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"returns ACTIVE_RENTAL_EXISTS\", function () { pm.expect(pm.response.json().code).to.eql(\"ACTIVE_RENTAL_EXISTS\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"renterId\": \"{{activeRentalRenterId}}\",\n  \"providerId\": \"canal-boat\",\n  \"vehicleId\": \"boat-8\"\n}",
