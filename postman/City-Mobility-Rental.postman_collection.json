{
  "info": {
    "_postman_id": "b56fdc5a-cf01-4be7-9b58-b69fb325c5a1",
    "name": "City Mobility Rental API",
    "description": "API-level acceptance checks for the rental use case. Start the app first with ./gradlew bootRun (Windows: .\\gradlew.bat bootRun), then run this collection in order against the default Spring Boot URL http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "cityBikeRenterId",
      "value": "",
      "type": "string"
    },
    {
      "key": "canalBoatRenterId",
      "value": "",
      "type": "string"
    },
    {
      "key": "activeRentalRenterId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Supported providers",
      "item": [
        {
          "name": "Start City Bike rental",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"cityBikeRenterId\", \"postman-city-bike-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 201 Created\", function () { pm.response.to.have.status(201); });",
                  "const response = pm.response.json();",
                  "pm.test(\"returns an active rental ID\", function () { pm.expect(response.rentalId).to.be.a(\"string\"); pm.expect(response.rentalId.length).to.be.greaterThan(0); pm.expect(response.status).to.eql(\"ACTIVE\"); });",
                  "pm.test(\"Location points to the created rental\", function () { pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/rentals/\" + response.rentalId); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"renterId\": \"{{cityBikeRenterId}}\",\n  \"providerId\": \"city-bike\",\n  \"vehicleId\": \"bike-42\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/api/rentals",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "rentals"
              ]
            }
          },
          "response": []
        },
